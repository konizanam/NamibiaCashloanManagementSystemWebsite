# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

DB_USER=postgres
DB_HOST=localhost
DB_NAME=nclms
DB_PASSWORD=changeme
DB_PORT=5432

JWT_SECRET=replace-with-long-random-hex
JWT_EXPIRES_IN=20m
JWT_PASSWORD_SETUP_EXPIRES_IN=3d

APP_BASE_URL=http://localhost:3000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_DEBUG=false

MAX_UPLOAD_SIZE=10485760

# Used by `npm run seed` to create the bootstrap admin user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=NCLMS Admin

# Cash Loan Management System API — powers the admin "Demo accounts" page.
# Called with HTTP Basic auth; must match TENANTS_API_USERNAME /
# TENANTS_API_PASSWORD set on the CMS API.
CMS_API_URL=
CMS_API_USERNAME=
CMS_API_PASSWORD=
