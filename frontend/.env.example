# Vite dev-server config. Copy to .env and adjust if you change ports.
# These are read by vite.config.ts via loadEnv() — no rebuild needed when
# you change them, just restart `npm run dev`.

# Port the Vite dev server listens on.
FRONTEND_PORT=3001

# Backend the dev server proxies /api, /docs, /openapi.json, /uploads to.
BACKEND_URL=http://localhost:5001
